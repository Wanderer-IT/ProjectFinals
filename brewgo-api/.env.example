# Copy this file to ".env" (cp .env.example .env). NEVER commit .env or real secret keys.
PORT=3000
PUBLIC_API_URL=http://localhost:3000
# Where your React PWA runs. Maya sends the customer back here after paying (/payment/success, /payment/cancelled).
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call this API (add your Vercel/Netlify URL when you deploy)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
WEBHOOK_SECRET=change-me-before-deploying
AI_ENABLED=true
TOKEN_TTL_HOURS=24
RATE_LIMIT_MAX=30

# ---- Payments ----
# maya = real Maya Checkout API (sandbox) | mock = built-in fake payment page, no internet needed
PAYMENT_PROVIDER=maya
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
# Maya's PUBLIC shared sandbox keys ("Sandbox Party 1", from developers.maya.ph > Sandbox Credentials and Cards).
# Fine for trying things out. Other developers use them at the same time, so for your defense generate your own
# sandbox keys in Maya Business Manager (Developer Sandbox Application Management) and paste them here.
# These are SANDBOX keys only: never use them in production.
MAYA_PUBLIC_KEY=pk-Z0OSzLvIcOI2UIvDhdTGVVfRSSeiGStnceqwUE7n0Ah
MAYA_SECRET_KEY=sk-X8qolYjy62kIzEbr0QRK1h4b4KDVHaNcwMYk39jInSl

# ---- Database (Supabase): REQUIRED, it is the only database ----
# 1) Supabase > SQL Editor: run supabase/schema.sql once (safe to run again).
# 2) Supabase > Project Settings > API: copy the Project URL and the "service_role" key (NOT the anon key).
# The service_role key is a SERVER secret: only put it in .env and Render's Environment tab, never in the React app or GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
